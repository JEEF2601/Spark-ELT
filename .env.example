# ==============================================================================
# CONFIGURACIÓN DE ENTORNO PARA SPARK-ELT (CLÚSTER DE EJECUCIÓN)
# ==============================================================================

# ------------------------------------------------------------------------------
# Conexión a servicios externos (InfluxDB, R2)
# ------------------------------------------------------------------------------
# InfluxDB (para los jobs de ejemplo)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=homeassistant
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=password_influx

# ------------------------------------------------------------------------------
# Configuración de R2 (Cloudflare Storage)
# ------------------------------------------------------------------------------
# Reemplazar con tus credenciales y bucket
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET=tu_bucket_r2
R2_PREFIX=influx/data
R2_REGION=auto

# ------------------------------------------------------------------------------
# Configuración de Spark
# ------------------------------------------------------------------------------
# Paquetes Maven para PySpark (opcional, descargados en runtime si aplica)
SPARK_JARS=org.apache.hadoop:hadoop-aws:3.4.2
SPARK_PACKAGES=org.apache.hadoop:hadoop-aws:3.4.2

# ------------------------------------------------------------------------------
# Variables para clonar repositorio etl-jobs (si fuera necesario)
# (Nota: En esta arquitectura, el código ETL se ejecuta desde Dagster)
ETL_JOBS_GIT_URL=https://github.com/JEEF2601/etl-jobs.git
ETL_JOBS_VERSION=v0.2.10
